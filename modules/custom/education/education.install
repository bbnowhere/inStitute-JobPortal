<?php

use Drupal\node\Entity\NodeType;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Implements hook_install().
 */
function education_uninstall() {
  // Clean up config or tables if needed.
}

function education_install() {
  // Create 'education' content type.
  if (!NodeType::load('education')) {
    $type = NodeType::create([
      'type' => 'education',
      'name' => 'Education',
      'description' => 'Stores educational qualifications from 10th to PhD.',
    ]);
    $type->save();
  }

  // Qualification group: 10th, 12th, Graduation, Post Graduation, PhD
  $qualifications = [
    '10th' => 'tenth',
    '12th' => 'twelfth',
    'graduation' => 'grad',
    'post_graduation' => 'pg',
    'phd' => 'phd',
  ];

  foreach ($qualifications as $q => $suffix) {
    // Qualification Name
    FieldStorageConfig::create([
      'field_name' => "field_{$suffix}_qual_name",
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
    ])->save();
    FieldConfig::create([
      'field_name' => "field_{$suffix}_qual_name",
      'entity_type' => 'node',
      'bundle' => 'education',
      'label' => "{$q} Qualification Name",
      'required' => FALSE,
    ])->save();

    // Specialization/Main Subjects
    FieldStorageConfig::create([
      'field_name' => "field_{$suffix}_spec",
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
    ])->save();
    FieldConfig::create([
      'field_name' => "field_{$suffix}_spec",
      'entity_type' => 'node',
      'bundle' => 'education',
      'label' => "{$q} Specialization/Main Subjects",
      'required' => FALSE,
    ])->save();

    // University/Institute
    FieldStorageConfig::create([
      'field_name' => "field_{$suffix}_univ",
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
    ])->save();
    FieldConfig::create([
      'field_name' => "field_{$suffix}_univ",
      'entity_type' => 'node',
      'bundle' => 'education',
      'label' => "{$q} University/Institute",
      'required' => FALSE,
    ])->save();

    // Country
    FieldStorageConfig::create([
      'field_name' => "field_{$suffix}_country",
      'entity_type' => 'node',
      'type' => 'string',
      'cardinality' => 1,
    ])->save();
    FieldConfig::create([
      'field_name' => "field_{$suffix}_country",
      'entity_type' => 'node',
      'bundle' => 'education',
      'label' => "{$q} Country",
      'required' => FALSE,
    ])->save();

    // Year of Passing
    FieldStorageConfig::create([
      'field_name' => "field_{$suffix}_year",
      'entity_type' => 'node',
      'type' => 'integer',
      'cardinality' => 1,
    ])->save();
    FieldConfig::create([
      'field_name' => "field_{$suffix}_year",
      'entity_type' => 'node',
      'bundle' => 'education',
      'label' => "{$q} Year of Passing",
      'required' => FALSE,
    ])->save();

    // % of marks (35 to 100)
    FieldStorageConfig::create([
      'field_name' => "field_{$suffix}_marks",
      'entity_type' => 'node',
      'type' => 'integer',
      'cardinality' => 1,
      'settings' => [
        'min' => 35,
        'max' => 100,
      ],
    ])->save();
    FieldConfig::create([
      'field_name' => "field_{$suffix}_marks",
      'entity_type' => 'node',
      'bundle' => 'education',
      'label' => "{$q} % of Marks",
      'required' => FALSE,
    ])->save();

    // GPA (1 to 10)
    FieldStorageConfig::create([
      'field_name' => "field_{$suffix}_gpa",
      'entity_type' => 'node',
      'type' => 'decimal',
      'cardinality' => 1,
      'settings' => [
        'precision' => 3,
        'scale' => 1,
        'min' => 1,
        'max' => 10,
      ],
    ])->save();
    FieldConfig::create([
      'field_name' => "field_{$suffix}_gpa",
      'entity_type' => 'node',
      'bundle' => 'education',
      'label' => "{$q} GPA",
      'required' => FALSE,
    ])->save();

    // Certificate Upload (PDF only)
    FieldStorageConfig::create([
      'field_name' => "field_{$suffix}_cert",
      'entity_type' => 'node',
      'type' => 'file',
      'cardinality' => 1,
      'settings' => [
        'uri_scheme' => 'public',
        'file_extensions' => 'pdf',
      ],
    ])->save();
    FieldConfig::create([
      'field_name' => "field_{$suffix}_cert",
      'entity_type' => 'node',
      'bundle' => 'education',
      'label' => "{$q} Certificate Upload",
      'required' => FALSE,
    ])->save();
  }
}
