<?php

use Drupal\node\Entity\NodeType;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

/**
 * Implements hook_schema().
 */
function referee_module_schema() {
  $schema['referee'] = [
    'description' => 'Table for storing referee information.',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'not null' => TRUE,
      ],
      'referee_1_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'referee_1_designation' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'referee_1_email' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'referee_1_phone' => [
        'type' => 'varchar',
        'length' => 20,
        'not null' => TRUE,
      ],
      'referee_1_address' => [
        'type' => 'text',
        'not null' => TRUE,
      ],
      'referee_2_name' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'referee_2_designation' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'referee_2_email' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'referee_2_phone' => [
        'type' => 'varchar',
        'length' => 20,
        'not null' => TRUE,
      ],
      'referee_2_address' => [
        'type' => 'text',
        'not null' => TRUE,
      ],
      'application_id' => [
        'type' => 'int',
        'not null' => TRUE,
      ],
    ],
    'primary key' => ['id'],
  ];

  return $schema;
}

/**
 * Implements hook_install().
 */
function referee_module_install() {
  // Create the Referee content type.
  if (!NodeType::load('referee')) {
    $type = NodeType::create([
      'type' => 'referee',
      'name' => 'Referee',
      'description' => 'Referee content type.',
    ]);
    $type->save();
  }

  // Helper function to create fields.
  function _referee_module_add_field($field_name, $type, $label, $settings = [], $required = FALSE) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $type,
        'settings' => $settings,
      ])->save();
    }
    if (!FieldConfig::loadByName('node', 'referee', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'referee',
        'label' => $label,
        'required' => $required,
        'settings' => $settings,
      ])->save();
    }
  }

  // Referee 1 fields.
  _referee_module_add_field('field_referee1_name', 'string', 'Referee 1 Name', [], TRUE);
  _referee_module_add_field('field_referee1_designation', 'string', 'Referee 1 Designation', [], TRUE);
  _referee_module_add_field('field_referee1_email', 'email', 'Referee 1 Email', [], TRUE);
  _referee_module_add_field('field_referee1_phone', 'string', 'Referee 1 Phone', ['max_length' => 10], TRUE);
  _referee_module_add_field('field_referee1_address', 'text_long', 'Referee 1 Address', [], FALSE);

  // Referee 2 fields.
  _referee_module_add_field('field_referee2_name', 'string', 'Referee 2 Name', [], TRUE);
  _referee_module_add_field('field_referee2_designation', 'string', 'Referee 2 Designation', [], TRUE);
  _referee_module_add_field('field_referee2_email', 'email', 'Referee 2 Email', [], TRUE);
  _referee_module_add_field('field_referee2_phone', 'string', 'Referee 2 Phone', ['max_length' => 10], TRUE);
  _referee_module_add_field('field_referee2_address', 'text_long', 'Referee 2 Address', [], FALSE);

  // Application entity reference field.
  _referee_module_add_field('field_application', 'entity_reference', 'Application', [
    'target_type' => 'node',
  ], FALSE);
}

/**
 * Implements hook_uninstall().
 */
function referee_module_uninstall() {
  drupal_uninstall_schema('referee_module');
}