<?php

use Drupal\node\Entity\NodeType;
use Drupal\field\Entity\FieldStorageConfig;
use Drupal\field\Entity\FieldConfig;

function file_upload_module_uninstall() {
  // Clean up config or tables if needed.
}



/**
 * Implements hook_install().
 */
function file_upload_module_install() {
  // Create the File Upload content type.
  if (!NodeType::load('file_upload')) {
    $type = NodeType::create([
      'type' => 'file_upload',
      'name' => 'File Upload',
      'description' => 'File Upload content type.',
    ]);
    $type->save();
  }

  // Helper function to create fields.
  function _file_upload_module_add_field($field_name, $type, $label, $settings = [], $required = FALSE) {
    if (!FieldStorageConfig::loadByName('node', $field_name)) {
      FieldStorageConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'type' => $type,
        'settings' => $settings,
      ])->save();
    }
    if (!FieldConfig::loadByName('node', 'file_upload', $field_name)) {
      FieldConfig::create([
        'field_name' => $field_name,
        'entity_type' => 'node',
        'bundle' => 'file_upload',
        'label' => $label,
        'required' => $required,
        'settings' => $settings,
      ])->save();
    }
  }

  // File fields (PDF, max 5MB).
  $file_settings = [
    'file_extensions' => 'pdf',
    'max_filesize' => '5 MB',
  ];

  _file_upload_module_add_field('field_pan_passport_dl_voter', 'file', 'PAN/Passport/DL/Voter ID', $file_settings, TRUE);
  _file_upload_module_add_field('field_resume', 'file', 'Resume', $file_settings, TRUE);
  _file_upload_module_add_field('field_experience_certificates', 'file', 'Upload Experience Certificates', $file_settings, FALSE);
  _file_upload_module_add_field('field_reservation_certificate', 'file', 'Reservation Certificate / Additional information', $file_settings, FALSE);

  // Application entity reference field.
  _file_upload_module_add_field('field_application', 'entity_reference', 'Application', [
    'target_type' => 'node',
  ], FALSE);

  // Transaction details (Long text).
  _file_upload_module_add_field('field_transaction_details', 'text_long', 'Transaction details of the application fee payment (If fee is not applicable enter NIL)', [], FALSE);

  // No Objection Certificate - List field.
  _file_upload_module_add_field('field_noc_option', 'list_string', 'No Objection Certificate', [
    'allowed_values' => [
      'upload' => 'I will upload NOC.',
      'produce' => 'I shall produce the No Objection Certificate before/at the time of Interview/Document Verification.',
      'na' => 'Not applicable',
    ],
  ], TRUE);

  // No Objection Certificate - File field (PDF, max 5MB).
  _file_upload_module_add_field('field_noc_file', 'file', 'No Objection Certificate File', $file_settings, FALSE);

  // Application entity reference field (again, if needed).
  _file_upload_module_add_field('field_application_ref', 'entity_reference', 'Application', [
    'target_type' => 'node',
  ], FALSE);
}
