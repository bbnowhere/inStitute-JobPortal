/**
 * Sends a well-formatted HTML application confirmation email.
 *
 * @param \Drupal\node\NodeInterface $entity
 *   The personal_information node that has just been marked as Completed.
 */
function instemjobportal_send_confirmation_email(\Drupal\node\NodeInterface $entity) {
  try {
    if ($entity->bundle() !== 'personal_information') {
      return;
    }

    $user = $entity->getOwner();
    $to = $user->getEmail();
    if (empty($to)) {
      \Drupal::logger('instemjobportal')->warning('No email found for applicant (UID: @uid).', ['@uid' => $user->id()]);
      return;
    }

    // Extract details.
    $application_id = $entity->get('field_application_id')->value ?? '';
    $job_nid = $entity->get('field_application')->target_id ?? '';
    $job_title = '';
    $job_code = '';
    $advt_number = '';

    if ($job_nid) {
      $job_node = \Drupal\node\Entity\Node::load($job_nid);
      if ($job_node) {
        $job_title = $job_node->label();
        $job_code = $job_node->get('field_job_code')->value ?? '';
        if ($job_node->hasField('field_advertisement_number') && !$job_node->get('field_advertisement_number')->isEmpty()) {
          $term = $job_node->get('field_advertisement_number')->entity;
          $advt_number = $term ? $term->label() : '';
        }
      }
    }

    // Pure inline HTML email body (safe for Gmail/Outlook).
    $html_body = '
    <!DOCTYPE html>
    <html>
      <body style="font-family: Arial, Helvetica, sans-serif; background-color: #f4f6f8; margin: 0; padding: 0;">
        <div style="background-color:#004080;color:#fff;text-align:center;padding:16px 24px;font-size:20px;font-weight:600;">
          Application Confirmation
        </div>
        <div style="max-width:600px;background-color:#fff;border-radius:8px;box-shadow:0 2px 8px rgba(0,0,0,0.1);
                    margin:24px auto;padding:24px;color:#333;">
          <p>Dear <strong>' . htmlspecialchars($user->getDisplayName()) . '</strong>,</p>
          <p>Thank you for submitting your application. Here are your details:</p>
          <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr><td style="font-weight:600;background:#f9fafb;padding:10px;">Application ID</td><td style="padding:10px;">' . htmlspecialchars($application_id) . '</td></tr>
            <tr><td style="font-weight:600;background:#f9fafb;padding:10px;">Job Title</td><td style="padding:10px;">' . htmlspecialchars($job_title) . ' (' . htmlspecialchars($job_code) . ')</td></tr>
            <tr><td style="font-weight:600;background:#f9fafb;padding:10px;">Advertisement No.</td><td style="padding:10px;">' . htmlspecialchars($advt_number) . '</td></tr>
          </table>
          <p>You can track your application anytime on our portal:</p>
          <div style="text-align:center;margin:20px 0;">
            <a href="https://beta.instem.res.in/jobportal" style="display:inline-block;background:#004080;color:#fff;
                text-decoration:none;padding:10px 16px;border-radius:4px;font-weight:600;">Visit Job Portal</a>
          </div>
          <p style="margin-top:24px;">Best regards,<br>
            <strong style="color:#004080;">Recruitment Team</strong><br>
            <span style="font-size:13px;color:#777;">Institute for Stem Cell Science and Regenerative Medicine (inStem)</span>
          </p>
        </div>
        <p style="text-align:center;font-size:12px;color:#999;">This is an automated message. Please do not reply.</p>
      </body>
    </html>';

    // Send email
    $mailManager = \Drupal::service('plugin.manager.mail');
    $module = 'instemjobportal';
    $key = 'application_submission';
    $langcode = $user->getPreferredLangcode();

    $params = [
      'subject' => t('Your Application Has Been Submitted'),
      'body' => $html_body,
    ];

    $result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, TRUE);

    if (empty($result['result'])) {
      \Drupal::logger('instemjobportal')->error('Failed to send confirmation email to %to (Application ID: %appid)', [
        '%to' => $to,
        '%appid' => $application_id,
      ]);
    }
    else {
      \Drupal::logger('instemjobportal')->notice('Confirmation email sent to %to (Application ID: %appid)', [
        '%to' => $to,
        '%appid' => $application_id,
      ]);
    }
  }
  catch (\Exception $e) {
    \Drupal::logger('instemjobportal')->error('Error sending confirmation email: @msg', ['@msg' => $e->getMessage()]);
  }
}

/**
 * Performs full revalidation across all applicant nodes before final submission.
 */
function instemjobportal_revalidate_application($uid, $job_nid, FormStateInterface $form_state) {
  $bundles = [
    'personal_information',
    'education',
    'employment_details',
    'referee',
    'additional_information',
    'file_upload',
  ];

  $has_error = FALSE;


  //  Load job node once.
  $job_node = !empty($job_nid)
    ? \Drupal\node\Entity\Node::load($job_nid)
    : NULL;



  if (!$job_node) {
    $form_state->setErrorByName('final_validation', t('Job details missing for validation.'));
    return FALSE;
  }

  foreach ($bundles as $bundle) {
    $nid = instemjobportal_find_application_node($bundle, $uid, $job_nid);
    if (!$nid) {
      $form_state->setErrorByName('final_validation', t('You must complete the @bundle section before final submission.', [
        '@bundle' => ucwords(str_replace('_', ' ', $bundle)),
      ]));
      $has_error = TRUE;
      continue;
    }

    $node = \Drupal\node\Entity\Node::load($nid);
    if (!$node) {
      continue;
    }



    // ------------------ PERSONAL INFORMATION ------------------
    if ($bundle === 'personal_information') {
      // Age
      if ($node->hasField('field_date_of_birth')) {
        $dob = $node->get('field_date_of_birth')->value ?? '';
        if (!empty($dob)) {
          try {
            $dob_dt = new \DateTime($dob);
            $age = $dob_dt->diff(new \DateTime())->y;
            $max_age = ($job_node->hasField('field_age_limit') && !$job_node->get('field_age_limit')->isEmpty())
              ? (int) $job_node->get('field_age_limit')->value : NULL;
            if ($age < 18 || ($max_age && $age > $max_age)) {
              $form_state->setErrorByName('field_date_of_birth', t('Age must be between 18 and @max years.', ['@max' => $max_age]));
              $has_error = TRUE;
            }
          }
          catch (\Exception $e) {
            $form_state->setErrorByName('field_date_of_birth', t('Invalid date of birth format.'));
            $has_error = TRUE;
          }
        }
      }

      // Category
      if ($node->hasField('field_category') && $job_node->hasField('field_category')) {
        $app_cat = strtolower(trim($node->get('field_category')->value ?? ''));
        $job_cat = strtolower(trim($job_node->get('field_category')->value ?? ''));
        if (!empty($job_cat) && $job_cat !== 'general' && $app_cat !== $job_cat) {
          $form_state->setErrorByName('field_category', t('Your category does not match the job’s category.'));
          $has_error = TRUE;
        }
      }

      // PwD
      if ($job_node->hasField('field_pwd_categories') && !$job_node->get('field_pwd_categories')->isEmpty()) {
        $job_pwd = $job_node->get('field_pwd_categories')->value;
        $app_pwd = $node->get('field_pwd_categories')->value ?? '';
        if ($job_pwd && $app_pwd !== $job_pwd) {
          $form_state->setErrorByName('field_pwd_categories', t('This job is not applicable for your PwD category.'));
          $has_error = TRUE;
        }
      }

        // Require category certificate when category is not 'general' or other_category indicates PwD.
        if ($node->hasField('field_category_certificate')) {
          $app_cat_val = strtolower(trim($node->get('field_category')->value ?? ''));
          $app_other_val = strtolower(trim($node->get('field_other_category')->value ?? ''));
          $other_is_pwd = $app_other_val !== '' && strpos($app_other_val, 'pwd') !== FALSE;
          if ($app_cat_val !== '' && $app_cat_val !== 'general' || $other_is_pwd) {
            $cert_empty = $node->get('field_category_certificate')->isEmpty();
            if ($cert_empty) {
              $form_state->setErrorByName('field_category_certificate', t('A category certificate is required when your category is not General or you have selected PwD in Other Category.'));
              $has_error = TRUE;
            }
          }
        }

  
    }
// ------------------ EMPLOYMENT DETAILS ------------------
 if ($bundle === 'employment_details') {
  if ($node->hasField('field_total_experience') && $job_node->hasField('field_min_experience')) {
    $app_exp = strtolower(trim($node->get('field_total_experience')->value ?? ''));
    $job_exp = (int) ($job_node->get('field_min_experience')->value ?? 0);

    $years = 0;
    $months = 0;

    if (preg_match('/(\d+)\s*year/', $app_exp, $match_year)) {
      $years = (int) $match_year[1];
    }
    if (preg_match('/(\d+)\s*month/', $app_exp, $match_month)) {
      $months = (int) $match_month[1];
    }

    $total_exp = $years + ($months / 12);

    if ($total_exp < $job_exp) {
      $form_state->setErrorByName('field_total_experience',
        t('Minimum @exp years of experience required. You have @y years @m months.', [
          '@exp' => $job_exp,
          '@y' => $years,
          '@m' => $months,
        ])
      );
      $has_error = TRUE;
    }
  }
}

    // ------------------ EDUCATION ------------------
    if ($bundle === 'education') {
      $percent_fields = [
        'field_10th_marks_percentage', 'field_12th_marks_percentage',
        'field_grad_marks', 'field_pg_marks', 'field_phd_marks', 'field_other_marks_percentage'
      ];
      foreach ($percent_fields as $field) {
        if ($node->hasField($field)) {
          $val = $node->get($field)->value;
          if ($val !== '' && $val !== NULL && (!is_numeric($val) || $val < 35 || $val > 100)) {
            $form_state->setErrorByName($field, t('%field must be between 35–100.', ['%field' => $field]));
            $has_error = TRUE;
          }
        }
      }

      $gpa_fields = ['field_10th_gpa','field_12th_gpa','field_grad_gpa','field_pg_gpa','field_phd_gpa','field_other_gpa'];
      foreach ($gpa_fields as $field) {
        if ($node->hasField($field)) {
          $val = $node->get($field)->value;
          if ($val !== '' && $val !== NULL && (!is_numeric($val) || $val < 1 || $val > 10)) {
            $form_state->setErrorByName($field, t('%field must be between 1–10.', ['%field' => $field]));
            $has_error = TRUE;
          }
        }
      }
    }

    // ------------------ REFEREE ------------------
    if ($bundle === 'referee') {
      $phone1 = $node->get('field_referee1_phone')->value ?? '';
      $phone2 = $node->get('field_referee2_phone')->value ?? '';
      $email1 = $node->get('field_referee1_email')->value ?? '';
      $email2 = $node->get('field_referee2_email')->value ?? '';

      if ($phone1 && !preg_match('/^\d{10}$/', $phone1)) {
        $form_state->setErrorByName('field_referee1_phone', t('Referee 1 phone must be 10 digits.'));
        $has_error = TRUE;
      }
      if ($phone2 && !preg_match('/^\d{10}$/', $phone2)) {
        $form_state->setErrorByName('field_referee2_phone', t('Referee 2 phone must be 10 digits.'));
        $has_error = TRUE;
      }
      if ($phone1 && $phone2 && $phone1 === $phone2) {
        $form_state->setErrorByName('field_referee2_phone', t('Referee phone numbers must be different.'));
        $has_error = TRUE;
      }
      if ($email1 && $email2 && strtolower($email1) === strtolower($email2)) {
        $form_state->setErrorByName('field_referee2_email', t('Referee emails must be different.'));
        $has_error = TRUE;
      }
    }
  }

  return !$has_error;
}

/**
 * Implements hook_mail_alter().
 */
function instemjobportal_mail_alter(&$message) {
  $registration_mail_ids = [
    // Drupal MailManager builds IDs as "{module}_{key}".
    'user_register_no_approval_required',
    'user_register_admin_created',
    // Keep dotted variants for compatibility with any custom integrations.
    'user.register_no_approval_required',
    'user.register_admin_created',
  ];
  if (!in_array($message['id'], $registration_mail_ids, TRUE)) {
    return;
  }

  $account = $message['params']['account'] ?? NULL;
  if (!$account instanceof UserInterface) {
    return;
  }

  if (empty($account->getEmail())) {
    return;
  }

  $timestamp = \Drupal::time()->getRequestTime();
  $hash = user_pass_rehash($account, $timestamp);
  $one_time_login_url = \Drupal::service('url_generator')->generateFromRoute(
    'user.reset',
    [
      'uid' => $account->id(),
      'timestamp' => $timestamp,
      'hash' => $hash,
    ],
    ['absolute' => TRUE]
  );

  /** @var \Drupal\instemjobportal\Service\EmailService $email_service */
  $email_service = \Drupal::service('instemjobportal.email_service');
  $mail_data = $email_service->buildRegistrationEmail($account, $one_time_login_url);

  // Override core registration mail content with custom Twig template output.
  $message['subject'] = $mail_data['subject'];
  $message['body'] = [$mail_data['message']];
  $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
  $message['headers']['MIME-Version'] = '1.0';

  \Drupal::logger('instemjobportal')->notice(
    'Custom registration template applied for @email on @mail_id.',
    [
      '@email' => $account->getEmail(),
      '@mail_id' => $message['id'],
    ]
  );
}