/**
 * Implements hook_preprocess_page().
 */
function instemjobportal_preprocess_page(&$variables) {
  $route_name = \Drupal::routeMatch()->getRouteName();

  // List of your six application content type machine names.
  $application_types = [
    'personal_information',
    'education',
    'employment_details',
    'referee',
    'additional_information',
    'file_upload',
  ];

  if ($route_name === 'node.add') {
    $node_type = \Drupal::routeMatch()->getParameter('node_type');
    // Support both string and NodeType object.
    $type_id = $node_type instanceof NodeType ? $node_type->id() : $node_type;
    if (in_array($type_id, $application_types, TRUE)) {
      // Set a custom title for each application type.
      $titles = [
        'personal_information' => 'Fill Personal Information',
        'education' => 'Fill Education Details',
        'employment_details' => 'Fill Employment Details',
        'referee' => 'Fill Referee Details',
        'additional_information' => 'Fill Additional Information',
        'file_upload' => 'Upload Supporting Documents',
      ];
      $variables['title'] = $titles[$type_id] ?? 'Fill Application';
    }
  }
}

/**
 * Implements hook_node_presave().
 *
 * Auto-increment advertisement numbers, set application titles,
 * calculate application IDs, DOB-based age, and total experience.
 */
function instemjobportal_node_presave(\Drupal\Core\Entity\EntityInterface $entity) {

   // instemjobportal_update_total_experience($entity);

  // 1. Auto-generate Advertisement Number for Job nodes.
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'job') {
    if ($entity->hasField('field_advertisement_number') && $entity->get('field_advertisement_number')->isEmpty()) {
      $year = date('Y');
      $query = \Drupal::entityQuery('node')
        ->condition('type', 'job')
        ->condition('status', 1)
        ->exists('field_advertisement_number')
        ->accessCheck(TRUE);

      $nids = $query->execute();
      $max_slno = 0;

      if (!empty($nids)) {
        $nodes = \Drupal\node\Entity\Node::loadMultiple($nids);
        foreach ($nodes as $node) {
          if ($node->hasField('field_advertisement_number') && !$node->get('field_advertisement_number')->isEmpty()) {
            $term_ref = $node->get('field_advertisement_number')->referencedEntities();
            if (!empty($term_ref)) {
              $term = reset($term_ref);
              $adv_value = $term->getName();
              if (preg_match('/^(\d+)-' . $year . '$/', $adv_value, $matches)) {
                $slno = (int) $matches[1];
                if ($slno > $max_slno) {
                  $max_slno = $slno;
                }
              }
            }
          }
        }
      }

      $next_slno = $max_slno + 1;
      $advertisement_number = $next_slno . '-' . $year;

      $vocab = 'advertisement_number';
      $term_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_term');
      $terms = $term_storage->loadByProperties([
        'name' => $advertisement_number,
        'vid' => $vocab,
      ]);

      if ($terms && ($term = reset($terms))) {
        $tid = $term->id();
      } else {
        $term = $term_storage->create([
          'name' => $advertisement_number,
          'vid' => $vocab,
        ]);
        $term->save();
        $tid = $term->id();
      }

      $entity->set('field_advertisement_number', ['target_id' => $tid]);
    }
  }

  // 2. Set automatic titles for related application content types.
  if ($entity->getEntityTypeId() === 'node') {
    $bundle = $entity->bundle();
    $application_bundles = [
      'education',
      'employment_details',
      'referee',
      'additional_information',
      'file_upload',
    ];
// Automatically link field_personal_info to the applicant's personal_information node.
if (in_array($bundle, $application_bundles, TRUE)) {
  if ($entity->hasField('field_application') && !$entity->get('field_application')->isEmpty()) {
    $job_nid = $entity->get('field_application')->target_id;
    $uid = $entity->getOwnerId();

    // Find the applicant's personal_information node for this job.
    $personal_nid = instemjobportal_find_application_node('personal_information', $uid, $job_nid);
    if (!empty($personal_nid) && $entity->hasField('field_personal_info')) {
      $entity->set('field_personal_info', ['target_id' => $personal_nid]);
    }
  }
}

    if (in_array($bundle, $application_bundles, TRUE)) {
      if ($entity->hasField('field_application') && !$entity->get('field_application')->isEmpty()) {
        $job_nid = $entity->get('field_application')->first()?->target_id ?? NULL;
        $uid = $entity->getOwnerId();

        $title_set = FALSE;
        if (!empty($job_nid) && !empty($uid)) {
          $personal_nid = instemjobportal_find_application_node('personal_information', $uid, $job_nid);
          if ($personal_nid) {
            $personal_node = \Drupal\node\Entity\Node::load($personal_nid);
            if ($personal_node && $personal_node->hasField('field_application_id') && !$personal_node->get('field_application_id')->isEmpty()) {
              $base_id = $personal_node->get('field_application_id')->value;
              $entity->setTitle($base_id . '-' . $bundle);
              $title_set = TRUE;
            }
          }
        }
        if (!$title_set) {
          $entity->setTitle($bundle . '-' . time());
        }
      } else {
        $entity->setTitle($bundle . '-' . time());
      }
    }
  }

  // 3. Handle Personal Information bundle.
  if ($entity->getEntityTypeId() === 'node' && $entity->bundle() === 'personal_information') {

    // Set Application ID based on Job reference.
    if ($entity->hasField('field_application') && !$entity->get('field_application')->isEmpty()) {
      $job_nid = $entity->get('field_application')->first()?->target_id ?? NULL;
      if (!empty($job_nid)) {
        $job_node = \Drupal\node\Entity\Node::load($job_nid);

        if ($job_node && $job_node->hasField('field_job_code') && !$job_node->get('field_job_code')->isEmpty()) {
          $job_code = $job_node->get('field_job_code')->value;

          // Do not overwrite an existing application id on updates.
          if ($entity->hasField('field_application_id') && !$entity->get('field_application_id')->isEmpty()) {
            // Already set; preserve existing application id.
          }
          else {

          // Use a lock to serialize application id generation per job so
          // concurrent submissions cannot receive the same serial number.
          $lock_name = 'instemjobportal_appid_job_' . $job_nid;
          $lock = \Drupal::lock();

          $acquired = FALSE;
          try {
            // Try to acquire the lock (default timeout 30s). If acquire
            // returns FALSE, we proceed without locking as a fallback.
            $acquired = $lock->acquire($lock_name, 30);

            // Collect existing application serials for this job.
            $query = \Drupal::entityQuery('node')
              ->condition('type', 'personal_information')
              ->condition('field_application.target_id', $job_nid)
              ->accessCheck(TRUE);
            if (!$entity->isNew()) {
              $query->condition('nid', $entity->id(), '!=');
            }
            $nids = $query->execute();

            $max_slno = 0;
            if (!empty($nids)) {
              $nodes = \Drupal\node\Entity\Node::loadMultiple($nids);
              foreach ($nodes as $n) {
                if ($n->hasField('field_application_id') && !$n->get('field_application_id')->isEmpty()) {
                  $appid = (string) $n->get('field_application_id')->value;
                  // Parse trailing integer after the last hyphen.
                  if (preg_match('/-(\d+)$/', $appid, $m)) {
                    $val = (int) $m[1];
                    if ($val > $max_slno) {
                      $max_slno = $val;
                    }
                  }
                }
              }
            }

            $slno = $max_slno + 1;
            $application_id = $job_code . '-' . $slno;

            if ($entity->hasField('field_application_id')) {
              $entity->set('field_application_id', $application_id);
            }
          }
          catch (\Throwable $e) {
            // In case of any error, fallback to previous simple count method.
            \Drupal::logger('instemjobportal')->error('Failed to generate application id with lock: @msg', ['@msg' => $e->getMessage()]);
            $query = \Drupal::entityQuery('node')
              ->condition('type', 'personal_information')
              ->condition('field_application.target_id', $job_nid)
              ->accessCheck(TRUE);
            if (!$entity->isNew()) {
              $query->condition('nid', $entity->id(), '!=');
            }
            $nids = $query->execute();
            $slno = count($nids) + 1;
            $application_id = $job_code . '-' . $slno;
            if ($entity->hasField('field_application_id')) {
              $entity->set('field_application_id', $application_id);
            }
          }
          finally {
            if ($acquired) {
              try {
                $lock->release($lock_name);
              }
              catch (\Throwable $e) {
                // Log and continue; failure to release is non-fatal here.
                \Drupal::logger('instemjobportal')->warning('Failed to release lock @lock: @msg', ['@lock' => $lock_name, '@msg' => $e->getMessage()]);
              }
            }
          }
          }
        }
      }
    }

    // Calculate and set Age from Date of Birth.
    if ($entity->hasField('field_date_of_birth') && !$entity->get('field_date_of_birth')->isEmpty()) {
      $dob = $entity->get('field_date_of_birth')->value;
      if ($dob) {
        $dob_dt = new \DateTime($dob);
        $now = new \DateTime();
        $age = $now->diff($dob_dt)->y;
        if ($entity->hasField('field_age')) {
          $entity->set('field_age', $age);
        }
      }
    }


  }
   // Calculate total experience from paragraph references.
  if ($entity->getEntityTypeId() === 'node' && $entity->hasField('field_employment_details')) {
  $total_days = 0;
  foreach ($entity->get('field_employment_details') as $item) {
    /** @var \Drupal\paragraphs\Entity\Paragraph $paragraph */
    $paragraph = $item->entity;
    if ($paragraph && !$paragraph->get('field_from_date')->isEmpty() && !$paragraph->get('field_to_date')->isEmpty()) {
      $from = new \DateTime($paragraph->get('field_from_date')->value, new \DateTimeZone('UTC'));
      $to   = new \DateTime($paragraph->get('field_to_date')->value, new \DateTimeZone('UTC'));
      $interval = $from->diff($to);
      $days = $interval->days;
      // Calculate experience as years with two decimals for the paragraph.
      $experience = round($days / 365, 2);

      if ($paragraph->hasField('field_experience_calculated')) {
        $paragraph->set('field_experience_calculated', $experience);
        $paragraph->save();
      }
      $total_days += $days;
    }
  }
  // Convert total days to years, months, days.
  $years = floor($total_days / 365);
  $remaining_days = $total_days % 365;
  $months = floor($remaining_days / 30);
  $days = $remaining_days % 30;
  $formatted = "{$years} years {$months} months {$days} days";

  // Save total experience in the node field as a string.
  if ($entity->hasField('field_total_experience')) {
    $entity->set('field_total_experience', $formatted);
  }
}
}

/**
 * Implements hook_theme().
 */
function instemjobportal_theme($existing, $type, $theme, $path) {
  return [
    'job_application_dashboard' => [
      'variables' => [
        'job' => NULL,
        'sections' => [],
        'completion' => NULL,
        'sidebar' => NULL,
      ],
      'template' => 'job-application-dashboard',
    ],
    'registration_email' => [
      'variables' => [
        'user' => NULL,
        'site_name' => NULL,
        'one_time_login_url' => NULL,
        'login_url' => NULL,
      ],
      'template' => 'registration-email',
    ],
    'application_sidebar_menu' => [
      'variables' => [
        'items' => [],
      ],
      'template' => 'application-sidebar-menu',
    ],
  ];
}

/**
 * Assign 'applicant' role to newly registered users.
 */
function instemjobportal_user_insert(UserInterface $account) {
  // Ensure role exists.
  $role_id = 'applicant';
  $role = \Drupal\user\Entity\Role::load($role_id);
  if (!$role) {
    // Create a bare role; permissions can be granted later via admin or permissions.yml.
    $role = \Drupal\user\Entity\Role::create(['id' => $role_id, 'label' => 'Applicant']);
    $role->save();
  }

  // Assign role to new user.
  $account->addRole($role_id);
  $account->save();

  // Email is sent and customized via hook_mail_alter().
}

/**
 * Implements hook_user_login().
 *
 * Set destination to front page so all users are redirected to home after login.
 */
function instemjobportal_user_login(UserInterface $account) {
  // Set the global destination so Drupal's redirect handling will send users to
  // the front page after successful login.
  // Only set a default destination if no destination is already present.
  // This avoids overriding explicit destinations (which may be internal or
  // external) and prevents attempts to force redirects to external URLs
  // that would be rejected by the redirect handling.
  $redirect_service = \Drupal::service('redirect.destination');
  $request = \Drupal::request();
  if (!$request->query->has('destination') && !$redirect_service->get()) {
    // Use site root path so RedirectResponseSubscriber will convert it to an
    // absolute URL and redirect to the homepage.
    $redirect_service->set('/');
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for the user login form.
 *
 * Inject a hidden 'destination' field with value '<front>' when no explicit
 * destination is provided in the query string. This ensures the login form
 * submit handler will preserve the destination and redirect users to the
 * front page after login.
 */
function instemjobportal_form_user_login_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // If a destination query parameter is already present, do nothing and
  // If a destination query parameter or a previously-set destination exists,
  // do nothing and preserve the explicit destination.
  $request = \Drupal::request();
  $redirect_service = \Drupal::service('redirect.destination');
  if ($request->query->has('destination') || $redirect_service->get()) {
    return;
  }

  // Add a hidden destination field that will be present in POST data so the
  // login submit handler uses it to redirect the user after successful login.
  $form['destination'] = [
    '#type' => 'hidden',
    // Use site root path so RedirectResponseSubscriber will convert it to an
    // absolute URL and redirect to the homepage.
    '#value' => '/',
    '#weight' => -100,
  ];
}

/**
 * Remove revision UI elements from node edit/add forms for application bundles.
 *
 * This hides the "Revision information / log message" tab and fields on the form.
 */
function instemjobportal_form_node_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  $application_bundles = [
    'personal_information',
    'education',
    'employment_details',
    'referee',
    'additional_information',
    'file_upload',
  ];
  $node = $form_state->getFormObject()->getEntity();
  if (in_array($node->bundle(), $application_bundles, TRUE)) {
    // After saving, you set 'saved_nid' in your submit handler.
    if ($nid = $form_state->get('saved_nid')) {
      // Hide the Save button.
      if (isset($form['actions']['submit'])) {
        unset($form['actions']['submit']);
      }
      // Show Edit button for the same node.
      $form['actions']['edit'] = [
        '#type' => 'link',
        '#title' => t('Edit'),
        '#url' => \Drupal\Core\Url::fromRoute('entity.node.edit_form', ['node' => $nid], [
          'query' => ['job' => \Drupal::request()->query->get('job')],
        ]),
        '#attributes' => ['class' => ['button', 'btn', 'btn-primary']],
      ];
    }
     
      if ($node->isNew()) {
        // You can use any logic here — e.g. user name, timestamp, etc.
        $form['title']['widget'][0]['value']['#default_value'] = ucfirst($node->bundle()) . ' - ' . date('YmdHis');
      }

      // Disable editing (make title read-only).
      $form['title']['widget'][0]['value']['#attributes']['readonly'] = 'readonly';
      $form['title']['widget'][0]['value']['#disabled'] = TRUE;

      // Optional: Add a note below the field.
      //$form['title']['widget'][0]['value']['#description'] = t('This title is automatically generated and cannot be changed.');
    

  }

  $node = $form_state->getFormObject()->getEntity();
  if (!$node) {
    return;
  }

  // Machine names of your six application content types.
  $application_bundles = [
    'personal_information',
    'education',
    'employment_details',
    'referee',
    'additional_information',
    'file_upload',
  ];

  if (in_array($node->bundle(), $application_bundles, TRUE)) {
    // Remove the revision vertical tab and log elements if present.
    if (isset($form['revision_information'])) {
      unset($form['revision_information']);
    }
    if (isset($form['revision'])) {
      unset($form['revision']);
    }
    if (isset($form['revision_log'])) {
      unset($form['revision_log']);
    }
    // Also remove the "Create new revision" checkbox if present.
    if (isset($form['revision_information']['revision'])) {
      unset($form['revision_information']['revision']);
    }
    // Add a submit handler that will keep the user on the same page after
    // saving and allow rendering a summary of the submitted data with an
    // edit link.
    if (isset($form['actions']['submit']['#submit'])) {
      $submit_handlers = &$form['actions']['submit']['#submit'];
      // Ensure a presave handler runs before core entity save.
      if (!in_array('instemjobportal_application_form_presave', $submit_handlers, TRUE)) {
        array_unshift($submit_handlers, 'instemjobportal_application_form_presave');
      }
      // Ensure post-save handler exists (it may be added elsewhere).
      if (!in_array('instemjobportal_application_form_submit', $submit_handlers, TRUE)) {
        $submit_handlers[] = 'instemjobportal_application_form_submit';
      }
    }

    // Add a validate handler to set the job reference and prevent duplicate
    // submissions for the same user + job + bundle.
    if (empty($form['#validate']) || !in_array('instemjobportal_application_form_validate', $form['#validate'], TRUE)) {
      $form['#validate'][] = 'instemjobportal_application_form_validate';
    }

    // If a job is provided via query parameter and the form has a
    // `field_application` widget, set the widget's default so the widget
    // receives a proper structure during form processing (prevents
    // Undefined array key "target_id" warnings). Only set on new nodes.
    $request = \Drupal::request();
    $job_param = $request->query->get('job');
    if (!empty($job_param) && $node->isNew() && isset($form['field_application'])) {
      $job_node = \Drupal\node\Entity\Node::load($job_param);
      if ($job_node) {
        // Ensure defaults are set anywhere under the field_application subtree
        // (covers wrappers like field_application_wrapper). This recursive
        // approach avoids widget-structure assumptions.
        if (isset($form['field_application'])) {
          instemjobportal_set_er_defaults_recursive($form['field_application'], $job_node);
        }
        if (isset($form['field_application_wrapper'])) {
          instemjobportal_set_er_defaults_recursive($form['field_application_wrapper'], $job_node);
        }
        // For tag-style (multiple) autocomplete widgets the field widget may
        // expect an array of default entities on the field level. Prefer
        // setting that first.
        if (isset($form['field_application']['#default_value'])) {
          $form['field_application']['#default_value'] = [$job_node];
        }
        // Typical structure for single-delta autocomplete widgets.
        if (isset($form['field_application'][0]['target_id'])) {
          $form['field_application'][0]['target_id']['#default_value'] = $job_node;
        }
        // Aggressive fallback: ensure the widget structure contains the
        // expected keys for the autocomplete tag widget. This covers
        // variations where the widget is nested under 'widget' or uses
        // different delta keys.
        // Build a visible display string like "Title (nid)" which the
        // autocomplete tag widget displays to the user. Ensure we set both
        // the entity default (for storage) and the textual default (for the
        // input element's visible value) across possible form element paths.
        $display = $job_node->label() . ' (' . $job_node->id() . ')';

        if (isset($form['field_application']['#default_value'])) {
          $form['field_application']['#default_value'] = [$job_node];
        }

        if (isset($form['field_application']['widget'][0]['target_id'])) {
          $el = & $form['field_application']['widget'][0]['target_id'];
          $el['#default_value'] = $job_node;
          // visible text for autocomplete input
          $el['#value'] = $display;
          $el['#default_value_display'] = $display;
          // some widgets expect '#autocomplete_route_parameters' to format
          // display; harmless to set.
          $el['#autocomplete_route_parameters'] = ['title' => $job_node->label()];
        } elseif (isset($form['field_application'][0]['widget'][0]['target_id'])) {
          $el = & $form['field_application'][0]['widget'][0]['target_id'];
          $el['#default_value'] = $job_node;
          $el['#value'] = $display;
          $el['#default_value_display'] = $display;
          $el['#autocomplete_route_parameters'] = ['title' => $job_node->label()];
        }
        // Also set the common single-delta path to display the job title and
        // provide a textual value for the input.
        if (isset($form['field_application'][0]['target_id'])) {
          $el = & $form['field_application'][0]['target_id'];
          $el['#default_value'] = $job_node;
          $el['#value'] = $display;
          $el['#default_value_display'] = $display;
        }
        // Also set a simple hidden value for non-autocomplete widgets as a
        // fallback.
        if (!isset($form['field_application'][0]['target_id']) && isset($form['field_application'][0])) {
          $form['field_application'][0]['target_id'] = [
            '#type' => 'hidden',
            '#value' => $job_node->id(),
          ];
        }
      }
    }

    // Add validation for education year fields.
    if ($node->bundle() === 'education') {
      $fields = [
        'field_10th_year_of_passing',
        'field_12th_year_of_passing',
        'field_grad_year',
        'field_other_year_of_passing',
        'field_pg_year',
        'field_phd_year',
      ];
      foreach ($fields as $field) {
        if (isset($form[$field]['widget'][0]['value'])) {
          $form[$field]['widget'][0]['value']['#element_validate'][] = 'instemjobportal_validate_mm_yyyy';
        }
      }
    }

    // If the form was just submitted and a saved node id exists in form
    // state, render a compact summary of the saved values and an Edit link so
    // the user can modify the submission without leaving the page.
    if ($nid = $form_state->get('saved_nid')) {
      $saved_node = \Drupal\node\Entity\Node::load($nid);
      if ($saved_node) {
        // Render the node using its view mode (e.g. 'full').
        $view_builder = \Drupal::entityTypeManager()->getViewBuilder('node');
        $node_render = $view_builder->view($saved_node, 'full');
        $form['instemjobportal_submission_preview'] = [
          '#type' => 'container',
          '#attributes' => ['class' => ['application-preview', 'mb-4']],
          'preview' => $node_render,
          '#weight' => 100,
        ];
        // Optionally, add a message or instructions.
        $form['instemjobportal_submission_preview']['info'] = [
          '#markup' => '<div class="mb-2 text-muted">To edit this section, use the Application Section.</div>',
          '#weight' => -1,
        ];
        // Remove the form fields so only the preview is shown.
        foreach ($form as $key => $value) {
          // Only unset visible form elements, not internal keys (those starting with '#').
          if (strpos($key, '#') !== 0 && $key !== 'instemjobportal_submission_preview' && $key !== 'actions') {
            unset($form[$key]);
          }
        }
      }
    }
  }
}

/**
 * Submit handler for application node forms.
 *
 * Stores the saved node id in form state and rebuilds the form so the summary
 * can be displayed on the same page. Also prevents redirect away from the
 * page by setting the redirect to the current route.
 */
function instemjobportal_application_form_submit($form, FormStateInterface $form_state) {
  $entity = $form_state->getFormObject()->getEntity();
  // Ensure it's a node.
  if ($entity instanceof NodeInterface && $entity->id()) {
    $form_state->set('saved_nid', $entity->id());

    $form_state->setRebuild(TRUE);

    // Preserve job query param on redirect if exists.
    $job_target = NULL;
    if ($entity->hasField('field_application') && !$entity->get('field_application')->isEmpty()) {
      $first = $entity->get('field_application')->first();
      if ($first && isset($first->target_id)) {
        $job_target = $first->target_id;
      }
    }

    // Set redirect.
    $redirect_options = !empty($job_target) ? ['query' => ['job' => $job_target]] : [];
    $form_state->setRedirect('<current>', [], $redirect_options);

    // Invalidate cache for user-job.
    if (!empty($job_target)) {
      $uid = $entity->getOwnerId();
      $tag = 'instemjobportal_app:job:' . $job_target . ':user:' . $uid;
      \Drupal::service('cache_tags.invalidator')->invalidateTags([$tag]);
    }
  }

// Send email only if personal_information node and status = completed.
if ($entity instanceof NodeInterface && $entity->bundle() === 'personal_information' && $entity->id()) {

  if ($entity->hasField('field_job_status')) {
    $status_val = trim(strtolower($form_state->getValue('field_job_status')[0]['value'] ?? $entity->get('field_job_status')->value ?? ''));

    if ($status_val === 'completed') {

      $user = $entity->getOwner();
      $to = $user->getEmail();

      if (!empty($to)) {
        // Gather job details.
        $application_id = $entity->get('field_application_id')->value ?? '';
        $job_nid = $entity->get('field_application')->target_id ?? '';
        $job_title = '';
        $job_code = '';
        $advt_number = '';

        if ($job_nid) {
          $job_node = Node::load($job_nid);
          if ($job_node instanceof NodeInterface) {
            $job_title = $job_node->label();
            $job_code = $job_node->get('field_job_code')->value ?? '';
            if ($job_node->hasField('field_advertisement_number') && !$job_node->get('field_advertisement_number')->isEmpty()) {
              $term = $job_node->get('field_advertisement_number')->entity;
              $advt_number = $term ? $term->label() : '';
            }
          }
        }

        $mailManager = \Drupal::service('plugin.manager.mail');
        $module = 'instemjobportal';
        $key = 'application_submission';
        $langcode = $user->getPreferredLangcode();

        $params['subject'] = 'Your Application Has Been Submitted';
        $params['body'] = (string) new FormattableMarkup('
          <div style="font-family: Arial, Helvetica, sans-serif;">
            <p>Dear <strong>@name</strong>,</p>
            <p>Your application (<strong>@appid</strong>) for <strong>@job</strong> has been submitted successfully.</p>
            <p>Advt. No.: @advtno</p>
          </div>',
          [
            '@name' => $user->getDisplayName(),
            '@appid' => $application_id,
            '@job' => $job_title . ($job_code ? ' (' . $job_code . ')' : ''),
            '@advtno' => $advt_number,
          ]
        );

        $params['headers'] = ['Content-Type' => 'text/html; charset=UTF-8'];

        $result = $mailManager->mail($module, $key, $to, $langcode, $params, NULL, TRUE);

        if (empty($result['result'])) {
          \Drupal::logger('instemjobportal')->error('Failed to send application confirmation email to %to', ['%to' => $to]);
        } else {
          \Drupal::logger('instemjobportal')->notice('Application confirmation email sent to %to', ['%to' => $to]);
        }
      }
    }
  } 
}

}
/**
 * Validate handler for application forms.
 *
 * - Sets the node's `field_application` (entity reference to job) from the
 * query parameter `job` when present.
 * - Prevents duplicate submissions by the same user for the same job and
 * bundle: if an existing node is found, set a form error and redirect the
 * user to edit the existing submission.
 */
function instemjobportal_application_form_validate($form, FormStateInterface $form_state) {
  $entity = $form_state->getFormObject()->getEntity();
  if (!($entity instanceof \Drupal\node\NodeInterface)) {
    return;
  }

  // Determine job id: prefer query parameter 'job'.
  $request = \Drupal::request();
  $job_id = $request->query->get('job');
  if (empty($job_id)) {
    $values = $form_state->getValues();
    if (!empty($values['job'])) {
      $job_id = $values['job'];
    }
  }

  // Prevent duplicate submissions.
  $current_user = \Drupal::currentUser();
  if ($current_user->isAuthenticated() && !empty($job_id)) {
    $existing_nid = instemjobportal_find_application_node($entity->bundle(), $current_user->id(), $job_id);
    if (!empty($existing_nid)) {
      \Drupal::messenger()->addStatus(t('You already have a submission for this job. Redirecting to your existing application.'));
      $form_state->setRedirect('entity.node.edit_form', ['node' => $existing_nid]);
      $form_state->setRebuild(FALSE);
      return;
    }
  }

  // Load the job node for validation.
  $job_node = NULL;
if (!empty($job_id)) {
  $job_node = \Drupal\node\Entity\Node::load($job_id);
}
// Only validate if job node is available.
if ($job_node) {

  // 1. Age Validation
  if ($entity->hasField('field_date_of_birth')) {
    // Prefer submitted value from form_state, fallback to entity field.
    $dob = $form_state->getValue('field_date_of_birth');
    if (is_array($dob)) {
      // Handle widget structures: ['value' => 'YYYY-MM-DD'] or [0 => ['value' => 'YYYY-MM-DD']]
      $dob = $dob['value'] ?? ($dob[0]['value'] ?? ($dob[0] ?? reset($dob)));
    }
    if (empty($dob)) {
      $dob = $entity->get('field_date_of_birth')->value ?? '';
    }
    // Debug log for troubleshooting
    \Drupal::logger('instemjobportal')->debug('DOB (form): @dob_form, DOB (entity): @dob_entity', [
      '@dob_form' => print_r($form_state->getValue('field_date_of_birth'), TRUE),
      '@dob_entity' => $entity->get('field_date_of_birth')->value ?? ''
    ]);
    if ($dob) {
      try {
        $dob_dt = new \DateTime($dob);
        $now = new \DateTime();
        $age = $dob_dt->diff($now)->y;
        \Drupal::logger('instemjobportal')->debug('DOB used: @dob, Age: @age', ['@dob' => $dob, '@age' => $age]);
        $max_age = ($job_node->hasField('field_age_limit') && !$job_node->get('field_age_limit')->isEmpty())
          ? (int) $job_node->get('field_age_limit')->value
          : NULL;
        if ($age < 18 || ($max_age && $age > $max_age)) {
          $form_state->setErrorByName(
            'field_date_of_birth',
            t('You are not eligible to apply. Your age must be between 18 and the maximum age limit specified for this job.')
          );
        }
      } catch (\Exception $e) {
        \Drupal::logger('instemjobportal')->error('Invalid DOB format: @dob. Error: @err', ['@dob' => $dob, '@err' => $e->getMessage()]);
        $form_state->setErrorByName('field_date_of_birth', t('Invalid date of birth format.'));
      }
    }
  }

  // 2. Category Validation (List field type)
  if ($entity->hasField('field_category') && $job_node->hasField('field_category')) {

    // Extract applicant category (form or entity fallback)
    $app_cat = $form_state->getValue('field_category');
    if (is_array($app_cat)) {
      $app_cat = $app_cat['value']
        ?? ($app_cat[0]['value'] ?? ($app_cat[0] ?? reset($app_cat)));
    }
    if (empty($app_cat)) {
      $app_cat = $entity->get('field_category')->value ?? '';
    }

    // Extract job category
    $job_cat = $job_node->get('field_category')->value ?? '';

    // If job_cat is not set or is 'general', skip category validation
    $job_cat_trimmed = strtolower(trim($job_cat));
    if (empty($job_cat_trimmed) || $job_cat_trimmed === 'general') {
      // No category restriction for this job, skip validation
    } else {
      // Normalize for comparison
      $app_cat = strtolower(trim($app_cat));
      if ($app_cat !== $job_cat_trimmed) {
        $form_state->setErrorByName(
          'field_category',
          t('Your selected category does not match the category allowed for this job.')
        );
      }
    }
  }

  // 3. Other Category Validation
  if ($job_node->hasField('field_other_category') && !$job_node->get('field_other_category')->isEmpty()) {
    $job_other_cat = $job_node->get('field_other_category')->value;
    if ($entity->hasField('field_other_category')) {
      $app_other_cat = $form_state->getValue('field_other_category');
      if (is_array($app_other_cat)) {
        $app_other_cat = $app_other_cat['value']
          ?? ($app_other_cat[0]['value'] ?? ($app_other_cat[0] ?? reset($app_other_cat)));
      }
      if (empty($app_other_cat)) {
        $app_other_cat = $entity->get('field_other_category')->value ?? '';
      }
      if ($app_other_cat !== $job_other_cat) {
        $form_state->setErrorByName(
          'field_other_category',
          t('Your selected other category does not match the job’s specified category.')
        );
      }
    }
  }

  // 4. PwD Category Validation
  if ($job_node->hasField('field_pwd_categories') && !$job_node->get('field_pwd_categories')->isEmpty()) {
    $job_pwd = $job_node->get('field_pwd_categories')->value;
    if ($entity->hasField('field_pwd_categories')) {
      $app_pwd = $form_state->getValue('field_pwd_categories');
      if (is_array($app_pwd)) {
        $app_pwd = $app_pwd['value']
          ?? ($app_pwd[0]['value'] ?? ($app_pwd[0] ?? reset($app_pwd)));
      }
      if (empty($app_pwd)) {
        $app_pwd = $entity->get('field_pwd_categories')->value ?? '';
      }
      if ($app_pwd !== $job_pwd) {
        $form_state->setErrorByName(
          'field_pwd_categories',
          t('This job is not applicable for your specified PwD category.')
        );
      }
    }
  }

  // 4b. Require category certificate when category is not 'general' or other_category indicates PWD.
  if ($entity->hasField('field_category_certificate')) {
    // Applicant category
    $app_cat_val = NULL;
    if ($entity->hasField('field_category')) {
      $app_cat_val = $form_state->getValue('field_category');
      if (is_array($app_cat_val)) {
        $app_cat_val = $app_cat_val['value'] ?? ($app_cat_val[0]['value'] ?? ($app_cat_val[0] ?? reset($app_cat_val)));
      }
      if (empty($app_cat_val)) {
        $app_cat_val = $entity->get('field_category')->value ?? '';
      }
    }
    $app_cat_val = strtolower(trim((string) $app_cat_val));

    // Applicant other category
    $app_other_val = NULL;
    if ($entity->hasField('field_other_category')) {
      $app_other_val = $form_state->getValue('field_other_category');
      if (is_array($app_other_val)) {
        $app_other_val = $app_other_val['value'] ?? ($app_other_val[0]['value'] ?? ($app_other_val[0] ?? reset($app_other_val)));
      }
      if (empty($app_other_val)) {
        $app_other_val = $entity->get('field_other_category')->value ?? '';
      }
    }
    $app_other_val = strtolower(trim((string) $app_other_val));

    // Consider other_category a PWD indicator if it contains 'pwd'.
    $other_is_pwd = $app_other_val !== '' && strpos($app_other_val, 'pwd') !== FALSE;

    if ($app_cat_val !== 'general' || $other_is_pwd) {
      $cert_val = $form_state->getValue('field_category_certificate');
      $has_cert = !empty($cert_val) || !$entity->get('field_category_certificate')->isEmpty();
      if (!$has_cert) {
        $form_state->setErrorByName('field_category_certificate', t('A category certificate is required when your category is not General or you have selected PwD in Other Category.'));
      }
    }
  }

  // 5. Experience Validation
  // if ($entity->hasField('field_total_experience') && $job_node->hasField('field_min_experience')) {
  //   $app_exp = (string) ($entity->get('field_total_experience')->value ?? '');
  //   $job_exp = (int) ($job_node->get('field_min_experience')->value ?? 0);

  //   // Extract years (handles strings like "2 years 3 months")
  //   preg_match('/(\d+)\s*year/', strtolower($app_exp), $matches);
  //   $years = isset($matches[1]) ? (int) $matches[1] : 0;

  //   if ($years < $job_exp) {
  //     $form_state->setErrorByName(
  //       'field_total_experience',
  //       t('You do not meet the minimum experience required for this position.')
  //     );
  //   }
  // }

  // Education CT: Validate marks percentage and GPA fields
  if ($entity->bundle() === 'education') {
    // Percentage fields: must be between 35 and 100
    $percent_fields = [
      'field_10th_marks_percentage',
      'field_12th_marks_percentage',
      'field_grad_marks',
      'field_pg_marks',
      'field_phd_marks',
      'field_other_marks_percentage',
    ];
    foreach ($percent_fields as $field) {
      if ($entity->hasField($field)) {
        $val = $form_state->getValue($field);
        if (is_array($val)) {
          $val = $val['value'] ?? ($val[0]['value'] ?? ($val[0] ?? reset($val)));
        }
        if ($val !== '' && $val !== NULL) {
          if (!is_numeric($val) || $val < 35 || $val > 100) {
            $form_state->setErrorByName($field, t('The value for %field must be between 35 and 100.', ['%field' => $field]));
          }
        }
      }
    }
    // GPA fields: must be between 1 and 10
    $gpa_fields = [
      'field_10th_gpa',
      'field_12th_gpa',
      'field_grad_gpa',
      'field_pg_gpa',
      'field_phd_gpa',
      'field_other_gpa',
    ];
    foreach ($gpa_fields as $field) {
      if ($entity->hasField($field)) {
        $val = $form_state->getValue($field);
        if (is_array($val)) {
          $val = $val['value'] ?? ($val[0]['value'] ?? ($val[0] ?? reset($val)));
        }
        if ($val !== '' && $val !== NULL) {
          if (!is_numeric($val) || $val < 1 || $val > 10) {
            $form_state->setErrorByName($field, t('The value for %field must be between 1 and 10.', ['%field' => $field]));
          }
        }
      }
    }
    $year_fields = [
      'field_10th_year_of_passing',
      'field_12th_year_of_passing',
      'field_grad_year',
      'field_pg_year',
      'field_phd_year',
      'field_other_year_of_passing',
    ];
    $years = [];
    foreach ($year_fields as $field) {
      $val = NULL;
      if ($entity->hasField($field)) {
        $val = $form_state->getValue($field);
        if (is_array($val)) {
          $val = $val['value'] ?? ($val[0]['value'] ?? ($val[0] ?? reset($val)));
        }
        if ($val !== '' && $val !== NULL) {
          $years[$field] = (int)substr($val, -4);
        }
      }
    }
    // 10th year <= 12th year
    if (isset($years['field_10th_year_of_passing'], $years['field_12th_year_of_passing'])) {
      if ($years['field_10th_year_of_passing'] > $years['field_12th_year_of_passing']) {
        $form_state->setErrorByName('field_10th_year_of_passing', t('10th year of passing cannot be greater than 12th year of passing.'));
        $form_state->setErrorByName('field_12th_year_of_passing', t('12th year of passing cannot be less than 10th year of passing.'));
      }
    }
    // 12th year <= grad year
    if (isset($years['field_12th_year_of_passing'], $years['field_grad_year'])) {
      if ($years['field_12th_year_of_passing'] > $years['field_grad_year']) {
        $form_state->setErrorByName('field_12th_year_of_passing', t('12th year of passing cannot be greater than graduation year.'));
        $form_state->setErrorByName('field_grad_year', t('Graduation year cannot be less than 12th year of passing.'));
      }
    }
    // grad year <= pg year
    if (isset($years['field_grad_year'], $years['field_pg_year'])) {
      if ($years['field_grad_year'] > $years['field_pg_year']) {
        $form_state->setErrorByName('field_grad_year', t('Graduation year cannot be greater than post graduation year.'));
        $form_state->setErrorByName('field_pg_year', t('Post graduation year cannot be less than graduation year.'));
      }
    }
    // pg year <= phd year
    if (isset($years['field_pg_year'], $years['field_phd_year'])) {
      if ($years['field_pg_year'] > $years['field_phd_year']) {
        $form_state->setErrorByName('field_pg_year', t('Post graduation year cannot be greater than PhD year.'));
        $form_state->setErrorByName('field_phd_year', t('PhD year cannot be less than post graduation year.'));
      }
    }
  }
    // Referee CT: Validate referee phone fields (must be 10 digits)
  if ($entity->bundle() === 'referee') {
    $phone_fields = [
      'field_referee1_phone',
      'field_referee2_phone',
    ];
    foreach ($phone_fields as $field) {
      if ($entity->hasField($field)) {
        $val = $form_state->getValue($field);
        if (is_array($val)) {
          $val = $val['value'] ?? ($val[0]['value'] ?? ($val[0] ?? reset($val)));
        }
        if ($val !== '' && $val !== NULL) {
          if (!preg_match('/^\d{10}$/', $val)) {
            $form_state->setErrorByName($field, t('The value for %field must be exactly 10 digits.', ['%field' => $field]));
          }
        }
      }
    }
  // Referee CT: Referee 1 and 2 phone/email must not be the same
 // Phone fields
    $phone1 = $form_state->getValue('field_referee1_phone');
    $phone2 = $form_state->getValue('field_referee2_phone');
    if (is_array($phone1)) {
      $phone1 = $phone1['value'] ?? ($phone1[0]['value'] ?? ($phone1[0] ?? reset($phone1)));
    }
    if (is_array($phone2)) {
      $phone2 = $phone2['value'] ?? ($phone2[0]['value'] ?? ($phone2[0] ?? reset($phone2)));
    }
    if (!empty($phone1) && !empty($phone2) && $phone1 === $phone2) {
      $form_state->setErrorByName('field_referee2_phone', t('Referee 1 and Referee 2 phone numbers must not be the same.'));
    }
    // Email fields
    $email1 = $form_state->getValue('field_referee1_email');
    $email2 = $form_state->getValue('field_referee2_email');
    if (is_array($email1)) {
      $email1 = $email1['value'] ?? ($email1[0]['value'] ?? ($email1[0] ?? reset($email1)));
    }
    if (is_array($email2)) {
      $email2 = $email2['value'] ?? ($email2[0]['value'] ?? ($email2[0] ?? reset($email2)));
    }
    if (!empty($email1) && !empty($email2) && strtolower($email1) === strtolower($email2)) {
      $form_state->setErrorByName('field_referee2_email', t('Referee 1 and Referee 2 email addresses must not be the same.'));
    }
  }
}
}

/**
 * Element validate callback for MM/YYYY date format.
 */
function instemjobportal_validate_mm_yyyy($element, FormStateInterface $form_state) {
  $value = $element['#value'];

  if (!empty($value) && !preg_match('/^(0[1-9]|1[0-2])\/\d{4}$/', $value)) {
    $form_state->setError(
      $element,
      'Enter a valid date in MM/YYYY format (Example: 05/2021).'
    );
  }
}

/**
 * Implements hook_entity_presave().
 * Calculate experience for each employment_detail paragraph.
 */
function instemjobportal_entity_presave(\Drupal\Core\Entity\EntityInterface $entity) {
  if ($entity->getEntityTypeId() === 'paragraph' && $entity->bundle() === 'employment_detail') {
    if ($entity->hasField('field_from_date') && $entity->hasField('field_to_date') &&
        !$entity->get('field_from_date')->isEmpty() && !$entity->get('field_to_date')->isEmpty()) {
      $from = new \DateTime($entity->get('field_from_date')->value, new \DateTimeZone('UTC'));
      $to   = new \DateTime($entity->get('field_to_date')->value, new \DateTimeZone('UTC'));
      $interval = $from->diff($to);
      $days = $interval->days;
      $years = floor($days / 365);
      $remaining_days = $days % 365;
      $months = floor($remaining_days / 30);
      $days_left = $remaining_days % 30;
      $experience_str = "{$years} years {$months} months {$days_left} days";
      $entity->set('field_experience_calculated', $experience_str);
    }
  }
}

/**
 * Find an existing application node for a given bundle, user and job id.
 *
 * This function prefers a field named `field_application` but will fall back
 * to any entity reference field on the bundle that references node entities.
 * Returns the first matching node id or NULL if none found.
 */
function instemjobportal_find_application_node($bundle, $uid, $job_id) {
  if (empty($bundle) || empty($uid) || empty($job_id)) {
    return NULL;
  }

  $field_definitions = \Drupal::service('entity_field.manager')->getFieldDefinitions('node', $bundle);
  $er_fields = [];
  foreach ($field_definitions as $name => $def) {
    if ($def->getType() === 'entity_reference') {
      $settings = $def->getSettings();
      if (!empty($settings['target_type']) && $settings['target_type'] === 'node') {
        $er_fields[] = $name;
      }
    }
  }

  // Prefer explicit field_application if present.
  if (in_array('field_application', $er_fields, TRUE)) {
    $er_fields = array_values(array_diff($er_fields, ['field_application']));
    array_unshift($er_fields, 'field_application');
  }

  foreach ($er_fields as $field_name) {
    $query = \Drupal::entityQuery('node')
      ->condition('type', $bundle)
      ->condition('uid', $uid)
      ->condition($field_name . '.target_id', $job_id)
      ->accessCheck(TRUE)
      ->range(0, 1);
    $results = $query->execute();
    if (!empty($results)) {
      return reset($results);
    }
  }

  return NULL;
}

/**
 * Presave handler that sets the field_application on the entity from the
 * request `job` parameter or a hidden form value. Runs early in form submit
 * so field widgets get the correct data during entity save.
 */
function instemjobportal_application_form_presave($form, FormStateInterface $form_state) {
  $entity = $form_state->getFormObject()->getEntity();
  if (!($entity instanceof \Drupal\node\NodeInterface)) {
    return;
  }

  $request = \Drupal::request();
  $job_id = $request->query->get('job');
  if (empty($job_id)) {
    $values = $form_state->getValues();
    if (!empty($values['job'])) {
      $job_id = $values['job'];
    }
  }

  if (!empty($job_id) && $entity->hasField('field_application')) {
    $entity->set('field_application', ['target_id' => $job_id]);
    // Ensure form values also contain the expected structure for field
    // widgets that will be processed during save.
    try {
      $form_state->setValue('field_application', [['target_id' => $job_id]]);
    } catch (\Throwable $e) {
    }
  }
}

/**
 * Recursively walk a form subtree and set autocomplete/ER defaults where we
 * find target_id elements. This makes the injection robust across widget
 * structures and wrappers.
 */
function instemjobportal_set_er_defaults_recursive(array &$element, \Drupal\Core\Entity\EntityInterface $job_node) {
  foreach ($element as $key => &$child) {
    if (!is_array($child)) {
      continue;
    }
    // If we find a target_id element, set defaults.
    if (isset($child['target_id']) && is_array($child['target_id'])) {
      $child['target_id']['#default_value'] = $job_node;
      $child['target_id']['#value'] = $job_node->id();
      $child['target_id']['#default_value_display'] = $job_node->label();
      // Some widgets expect this exact key.
      $child['target_id']['#autocomplete_route_parameters'] = ['title' => $job_node->label()];
    }
    // Also handle nested widget path.
    if (isset($child['widget']) && is_array($child['widget'])) {
      instemjobportal_set_er_defaults_recursive($child['widget'], $job_node);
    }
    // Recurse into deeper arrays to find any target_id occurrences.
    instemjobportal_set_er_defaults_recursive($child, $job_node);
  }
}

/**
 * Remove revision-related local tasks (tabs) so revision links do not show.
 *
 * This hides local task tabs whose route names contain "revision".
 */
function instemjobportal_menu_local_tasks_alter(&$data, $route_name) {
  // If we're on a node edit page for one of our application bundles and a
  // job context exists (either via ?job or the node's field_application),
  // remove the View and Edit tabs to prevent the user navigating away from
  // the job-scoped flow.
  $is_node_edit = ($route_name === 'entity.node.edit_form');
  $job_query = \Drupal::request()->query->get('job');
  $application_bundles = [
    'personal_information',
    'education',
    'employment_details',
    'referee',
    'additional_information',
    'file_upload',
  ];

  // Attempt to determine the node and whether it references a job.
  $node_param = \Drupal::routeMatch()->getParameter('node');
  $node_bundle = NULL;
  $node_has_job = FALSE;
  if ($node_param) {
    if (is_object($node_param) && method_exists($node_param, 'bundle')) {
      $node_bundle = $node_param->bundle();
      if (method_exists($node_param, 'hasField') && $node_param->hasField('field_application') && !$node_param->get('field_application')->isEmpty()) {
        $node_has_job = TRUE;
      }
    } else {
      try {
        $loaded = \Drupal\node\Entity\Node::load($node_param);
        if ($loaded) {
          $node_bundle = $loaded->bundle();
          if ($loaded->hasField('field_application') && !$loaded->get('field_application')->isEmpty()) {
            $node_has_job = TRUE;
          }
        }
      } catch (\Throwable $e) {
        // ignore
      }
    }
  }

  foreach ($data as $context => $tasks) {
    foreach ($tasks as $delta => $task) {
      if (!empty($task['#link']['route_name'])) {
        $rname = $task['#link']['route_name'];
        if (str_contains($rname, 'revision') || str_contains($rname, 'revisions')) {
          unset($data[$context][$delta]);
          continue;
        }

        // Remove View/Edit tabs during node edit for application bundles
        // when job context is present.
        if ($is_node_edit && in_array($rname, ['entity.node.canonical', 'entity.node.edit_form'])) {
          $has_job_context = !empty($job_query) || $node_has_job;
          if ($has_job_context && in_array($node_bundle, $application_bundles, TRUE)) {
            unset($data[$context][$delta]);
            continue;
          }
        }
      }
    }
    // Reindex numeric arrays to avoid gaps.
    if (isset($data[$context]) && is_array($data[$context])) {
      $data[$context] = array_values($data[$context]);
    }
  }
}

/**
 * Grant edit access to the owner of an application node that references a
 * job via `field_application` so applicants can edit their own submissions.
 */
function instemjobportal_node_access(NodeInterface $node, $operation, AccountInterface $account) {
  $roles = $account->getRoles();
  $content_type = $node->bundle();

  /**
   * ----------------------------------------------------
   * PART 1: UPDATE ACCESS (EDIT)
   * ----------------------------------------------------
   */
  if ($operation === 'update') {

    $application_bundles = [
      'personal_information',
      'education',
      'employment_details',
      'referee',
      'additional_information',
      'file_upload',
    ];

    // Only apply to application bundles.
    if (!in_array($content_type, $application_bundles, TRUE)) {
      return AccessResult::neutral();
    }

    // Node must reference a job.
    if ($node->hasField('field_application') && !$node->get('field_application')->isEmpty()) {
      $job_id = $node->get('field_application')->target_id;

      // Owner editing their own application.
      if ($node->getOwnerId() == $account->id()) {

        // Check if personal_information status is completed.
        try {
          $personal_nid = instemjobportal_find_application_node('personal_information', $account->id(), $job_id);
          if ($personal_nid) {
            $pnode = \Drupal\node\Entity\Node::load($personal_nid);
            if ($pnode && $pnode->hasField('field_job_status')) {
              $status = strtolower((string) $pnode->get('field_job_status')->value);
              if ($status === 'completed') {
                return AccessResult::forbidden(); // Cannot edit after submission
              }
            }
          }
        }
        catch (\Throwable $e) {
          return AccessResult::allowed();
        }

        return AccessResult::allowed(); // Not completed yet
      }
    }

    return AccessResult::neutral();
  }

  /**
   * ----------------------------------------------------
   * PART 2: VIEW ACCESS
   * ----------------------------------------------------
   */
  if ($operation === 'view') {

    // Anonymous users → Only Job CT
    if ($account->isAnonymous()) {
      if ($content_type === 'job') {
        return AccessResult::allowed()->cachePerPermissions();
      }
      return AccessResult::forbidden()->cachePerPermissions();
    }

    // Admin + HR → Can view everything
    if (in_array('administrator', $roles) || in_array('hr', $roles)) {
      return AccessResult::allowed()->cachePerPermissions();
    }

    // Applicant: can view ONLY their own nodes
  if (in_array('applicant', $roles)) {

  // Applicants can always view Job CT.
  if ($content_type === 'job') {
    return AccessResult::allowed()->cachePerPermissions();
  }

  // Applicants can view ONLY their own nodes for other CTs.
  if ($node->getOwnerId() == $account->id()) {
    return AccessResult::allowed()->cachePerUser();
  }

  return AccessResult::forbidden()->cachePerUser();
}


    // All others denied
    return AccessResult::forbidden();
  }

  return AccessResult::neutral();
}


/**
 * Implements hook_block_view_alter().
 */
function instemjobportal_block_view_alter(array &$build, BlockPluginInterface $block) {
  // Target the core page title block (plugin id contains "page_title").
  $plugin_id = $block->getPluginId();
  if (strpos($plugin_id, 'page_title') === FALSE) {
    return;
  }

  $route_match = \Drupal::routeMatch();
  if ($route_match->getRouteName() !== 'node.add') {
    return;
  }

  $node_type = $route_match->getParameter('node_type');
  $type_id = ($node_type instanceof \Drupal\node\Entity\NodeType) ? $node_type->id() : $node_type;
  $titles = [
    'personal_information' => 'Fill Personal Information',
    'education' => 'Fill Education Details',
    'employment_details' => 'Fill Employment Details',
    'referee' => 'Fill Referee Details',
    'additional_information' => 'Fill Additional Information',
    'file_upload' => 'Upload Supporting Documents',
  ];

  if (!empty($type_id) && isset($titles[$type_id])) {
    // Set title used by the block render array.
    $build['#title'] = $titles[$type_id];
    // Also ensure rendered content uses the new title.
    if (isset($build['content'])) {
      $build['content'] = [
        '#type' => 'container',
        'title' => [
          '#markup' => '<h1 class="title">' . $titles[$type_id] . '</h1>',
        ],
      ];
    }
  }
}

/**
 * Implements hook_form_alter().
 * Deny access to application add forms if ?job is missing for applicants.
 */
function instemjobportal_form_alter(&$form, \Drupal\Core\Form\FormStateInterface $form_state, $form_id) {
  // Only target node add/edit forms for application bundles.
  $application_form_ids = [
    'node_personal_information_form',
    'node_education_form',
    'node_employment_details_form',
    'node_referee_form',
    'node_additional_information_form',
    'node_file_upload_form',
  ];
  if (!in_array($form_id, $application_form_ids, TRUE)) {
    return;
  }

  // Remove all status messages for these forms.
  $messenger = \Drupal::messenger();
  $messenger->deleteByType('status');

  $current_user = \Drupal::currentUser();
  $is_applicant = in_array('applicant', $current_user->getRoles());
  $request = \Drupal::request();
  $job_param = $request->query->get('job');

  // If user is applicant and ?job is missing, deny access.
  if ($is_applicant && empty($job_param)) {
    $form['#access'] = FALSE;
    \Drupal::messenger()->addError(t('Access denied: You must use a valid job link to apply.'));
    return;
  }

  // Prevent further access if already submitted for this job.
  if ($is_applicant && !empty($job_param)) {
    $uid = $current_user->id();
    $personal_nid = instemjobportal_find_application_node('personal_information', $uid, $job_param);
    if ($personal_nid) {
      $personal_node = \Drupal\node\Entity\Node::load($personal_nid);
 if (
  $personal_node &&
  $personal_node->hasField('field_job_status')
) {
  $job_status = $personal_node->get('field_job_status')->value ?? '';

  if (strtolower($job_status) === 'completed') {
    $form['#access'] = FALSE;
    \Drupal::messenger()->addError(t('You have already submitted your application for this job. Further submissions are not allowed.'));
  }
}

    }
  }

  // Remove status messages after saving for application bundles.
  $application_form_ids = [
    'node_personal_information_form',
    'node_education_form',
    'node_employment_details_form',
    'node_referee_form',
    'node_additional_information_form',
    'node_file_upload_form',
  ];
  if (in_array($form_id, $application_form_ids, TRUE)) {
    // If the form is being rebuilt after save (preview mode), clear status messages.
    if ($form_state->get('saved_nid')) {
      $messenger = \Drupal::messenger();
      foreach ($messenger->all() as $type => $messages) {
        if ($type === 'status') {
          foreach ($messages as $message) {
            $messenger->deleteByType('status');
          }
        }
      }
    }
  }
}

/**
 * Implements hook_page_attachments_alter().
 * Remove status messages for application bundles on node pages.
 */
function instemjobportal_page_attachments_alter(array &$attachments) {
  $route_match = \Drupal::routeMatch();
  if ($node = $route_match->getParameter('node')) {
    if (is_object($node) && method_exists($node, 'bundle')) {
      $bundle = $node->bundle();
      $application_bundles = [
        'personal_information',
        'education',
        'employment_details',
        'referee',
        'additional_information',
        'file_upload',
      ];
      if (in_array($bundle, $application_bundles, TRUE)) {
        \Drupal::messenger()->deleteByType('status');
      }
    }
  }
}

/**
 * Implements hook_mail().
 */
function instemjobportal_mail($key, &$message, $params) {
  switch ($key) {
    case 'application_submission':
      $message['subject'] = $params['subject'];
      $message['body'] = [$params['body']];
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      $message['headers']['MIME-Version'] = '1.0';
      break;

    case 'register':
      $message['subject'] = $params['subject'] ?? '';
      $message['body'] = [(string) ($params['message'] ?? '')];
      $message['headers']['Content-Type'] = 'text/html; charset=UTF-8';
      $message['headers']['MIME-Version'] = '1.0';
      break;
  }
}


