//   // \Drupal::logger('instemjobportal')->debug('normalized sections: @data', ['@data' => print_r($variables['sections'], TRUE)]);
// }

function instemjobportal_preprocess_job_application_dashboard(array &$variables) {
  $sections = $variables['sections'] ?? [];

  $safe = [];
  foreach ($sections as $key => $item) {
    // Convert boolean -> array
    if ($item === TRUE) {
      $item = ['title' => ucfirst(str_replace('_', ' ', $key)), 'status' => 'complete'];
    }
    elseif ($item === FALSE) {
      continue;
    }
    elseif (!is_array($item)) {
      // Convert scalars/objects to array
      $item = ['title' => (string) $item, 'status' => 'incomplete'];
    }

    // Guarantee title and status keys
    $item['title'] = $item['title'] ?? ucfirst(str_replace('_', ' ', $key));
    $item['status'] = $item['status'] ?? 'incomplete';

    $safe[] = $item;
  }

  $variables['sections'] = $safe;
  $variables['items'] = array_map(function ($s) {
    return [
      'title' => $s['title'],
      'link' => $s['link'] ?? NULL,
      'status' => $s['status'],
    ];
  }, $safe);
  \Drupal::logger('instemjobportal')->debug('Sections raw: @data', [
  '@data' => print_r($variables['sections'], TRUE),
]);

}




/**
 * AJAX callback to show/hide category fields based on reservation value.
 */
function instemjobportal_category_reservation_ajax_callback(array &$form, FormStateInterface $form_state) {
  $trigger = $form_state->getValue('field_category_reservation');
  if ($trigger === 'ticket') {
    if (isset($form['category_fields_wrapper']['field_category'])) {
      $form['category_fields_wrapper']['field_category']['#access'] = TRUE;
    }
    if (isset($form['category_fields_wrapper']['field_other_category'])) {
      $form['category_fields_wrapper']['field_other_category']['#access'] = TRUE;
    }
  }
  else {
    if (isset($form['category_fields_wrapper']['field_category'])) {
      $form['category_fields_wrapper']['field_category']['#access'] = FALSE;
    }
    if (isset($form['category_fields_wrapper']['field_other_category'])) {
      $form['category_fields_wrapper']['field_other_category']['#access'] = FALSE;
    }
  }

  return $form['category_fields_wrapper'] ?? [];
}
