{# Custom page template for Instem Theme using Bootstrap navbar and footer #}
<header class="navbar navbar-expand-lg navbar-light bg-light">
  <div class="container d-flex align-items-center">
    <a class="navbar-brand d-flex align-items-center me-3" href="/">
      {% if logo %}
        <img src="{{ logo }}" alt="{{ site_name|default('Home') }}" />
      {% endif %}
      {% if site_name %}
        <span class="ms-2">{{ site_name }}</span>
      {% endif %}
    </a>
    <div class="d-flex align-items-center ms-auto">
      {% if page.header %}
        {{ page.header }}
      {% endif %}
      {% if page.primary_menu %}
        {{ page.primary_menu }}
      {% endif %}
    </div>
  </div>
</header>
<div class="container">
  <div class="row">
    {% if page.sidebar_first %}
      <aside class="col-md-3" role="complementary">
        {{ page.sidebar_first }}
      </aside>
    {% endif %}
    <main class="col-md-12" role="main">
      {{ page.content }}
    </main>
    {% if page.sidebar_second %}
      <aside class="col-md-3" role="complementary">
        {{ page.sidebar_second }}
      </aside>
    {% endif %}
  </div>
</div>
<footer class="footer bg-dark text-white mt-auto py-3">
  <div class="container text-center">
    {% if page.footer %}
      {{ page.footer }}
    {% endif %}
    <span>&copy; {{ "now"|date("Y") }} Instem Theme. All rights reserved.</span>
  </div>
</footer>
