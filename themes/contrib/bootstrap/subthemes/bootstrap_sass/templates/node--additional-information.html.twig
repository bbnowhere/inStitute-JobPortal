{# filepath: themes/contrib/bootstrap/subthemes/bootstrap_sass/templates/node--additional-information.html.twig #}
<div class="card shadow mb-4">
  <div class="card-header bg-primary text-white">
    Additional Information
  </div>
  <div class="card-body">
    <table class="table table-bordered table-striped">
      <tbody>
        <tr><th>Have you ever been involved in any administrative malpractice?</th><td>{{ content.field_admin_malpractice }}</td></tr>
        <tr><th>Malpractice Details</th><td>{{ content.field_admin_malpractice_details }}</td></tr>
        <tr><th>Have you been debarred or punished for adopting unfair means in any Examination by the Institution/Board/University?	</th><td>{{ content.field_debarred_unfair_means }}</td></tr>
        <tr><th>Debarred Details</th><td>{{ content.field_debarred_details }}</td></tr>
        <tr><th>Were you ever discharged or dismissed from any previous employment?	</th><td>{{ content.field_discharged_employment }}</td></tr>
        <tr><th>Discharged Employment Details</th><td>{{ content.field_discharged_employment_d }}</td></tr>
        <tr><th>Is there any pending or contemplated disciplinary proceedings against you?	</th><td>{{ content.field_disciplinary_proceedings }}</td></tr>
        <tr><th>Disciplinary Proceedings Details</th><td>{{ content.field_disciplinary_proceedings_d }}</td></tr>
        <tr><th>Have you ever been involved in any financial irregularity?	</th><td>{{ content.field_financial_irregularity }}</td></tr>
        <tr><th>Financial Irregularity Details</th><td>{{ content.field_financial_irregularity_d }}</td></tr>
        <tr><th>Time required for joining from the date of receiving offer letter (in days)	</th><td>{{ content.field_joining_time_days }}</td></tr>
        <tr><th>Kindly describe significant contributions where you have worked?	s</th><td>{{ content.field_significant_contributions }}</td></tr>
        <tr><th>What makes you suitable for the post you have applied? (Please describe in maximum 500 words)	</th><td>{{ content.field_suitability }}</td></tr>
      </tbody>
    </table>
  </div>
</div>