{# filepath: themes/contrib/bootstrap/subthemes/bootstrap_sass/templates/node--personal-information.html.twig #}
<div class="card shadow mb-4">
  <div class="card-header bg-primary text-white">
    Personal Information
  </div>
  <div class="card-body">
<div class="row mb-3">

  <div class="col-md-3 text-center">
    {% if photo_base64 is defined %}
      <img src="{{ photo_base64 }}" class="img-thumbnail mb-2" style="max-width:120px;">
    {% endif %}
    <div class="small text-muted">Photo</div>
  </div>

  <div class="col-md-3 text-center">
    {% if signature_base64 is defined %}
      <img src="{{ signature_base64 }}" class="img-thumbnail mb-2" style="max-width:120px;">
    {% endif %}
    <div class="small text-muted">Signature</div>
  </div>

</div>

    </div>
    <table class="table table-bordered table-striped">
      <tbody>
        <tr><th>Full Name</th><td>{{ (node.field_full_name.value is iterable ? node.field_full_name.value|join(' ') : node.field_full_name.value)|upper }}</td></tr>
        <tr><th>Date of Birth</th><td>{{ node.field_date_of_birth.value }}</td></tr>
        <tr><th>Age</th><td>{{ node.field_age.value }}</td></tr>
        <tr><th>Father/Mother/Spouse Name</th><td>{{ (node.field_father_mother_spouse_name.value is iterable ? node.field_father_mother_spouse_name.value|join(' ') : node.field_father_mother_spouse_name.value)|capitalize }}</td></tr>
        <tr><th>Email</th><td>{{ node.field_email.value }}</td></tr>
        <tr><th>Gender</th><td>{{ (node.field_gender.value is iterable ? node.field_gender.value|join(' ') : node.field_gender.value)|capitalize }}</td></tr>
        <tr><th>Category</th><td>{{ (node.field_category.value is iterable ? node.field_category.value|join(' ') : node.field_category.value)|upper }}</td></tr>
        <tr><th>PWD Category</th><td>{{ (node.field_pwd_category.value is iterable ? node.field_pwd_category.value|join(' ') : node.field_pwd_category.value)|upper }}</td></tr>
        <tr><th>Category Certificate</th><td>{{ (node.field_category_certificate.value is iterable ? node.field_category_certificate.value|join(' ') : node.field_category_certificate.value)|capitalize }}</td></tr>
        <tr><th>Mobile Number</th><td>{{ node.field_mobile_number.value }}</td></tr>
        <tr><th>Marital Status</th><td>{{ (node.field_marital_status.value is iterable ? node.field_marital_status.value|join(' ') : node.field_marital_status.value)|upper }}</td></tr>
        <tr><th>Nationality</th><td>{{ (node.field_nationality.value is iterable ? node.field_nationality.value|join(' ') : node.field_nationality.value)|upper }}</td></tr>
        <tr><th>Alternate Phone</th><td>{{ node.field_alternate_phone.value }}</td></tr>
        <tr><th>Permanent Address</th><td>{{ node.field_permanent_address.value }}</td></tr>
        <tr><th>Correspondence Address</th><td>{{ node.field_correspondence_address.value }}</td></tr>
        <tr><th>Departmental Candidate</th><td>{{ (node.field_departmental_candidate.value is iterable ? node.field_departmental_candidate.value|join(' ') : node.field_departmental_candidate.value)|capitalize }}</td></tr>
        <tr><th>Brief particulars about departmental candidates i.e. who are all entitled to get the benefits of departmental candidate.</th><td>{{ node.field_departmental_candidate_details.value ?: '-' }}</td></tr>
        <tr><th>Experience Level</th><td>{{ (node.field_experience_level.value is iterable ? node.field_experience_level.value|join(' ') : node.field_experience_level.value)|upper }}</td></tr>
      </tbody>
    </table>
  </div>
</div>