{{ attach_library('bootstrap_sass/application') }}

<nav class="application-sidebar sticky-top pt-3">
  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title mb-3">Application Sections</h5>
      <ul class="list-unstyled mb-0">
        {% for item in items|default([]) %}
          {% set sstatus = item.status|default('incomplete') %}
          {% set item_class = sstatus == 'complete' ? 'completed' : (sstatus == 'in-progress' ? 'in-progress' : 'incomplete') %}
          <li class="sidebar-item d-flex align-items-start mb-3 {{ item_class }}">
            <div class="step-number me-3">
              <span class="badge rounded-circle bg-light text-dark border">{{ loop.index }}</span>
            </div>
            <div class="flex-grow-1">
              <div class="d-flex justify-content-between align-items-start">
                {% if item.link is defined and item.link %}
                  {# If link is a render array / iterable, render it directly to avoid trim() on array. #}
                  {% if item.link is iterable %}
                    {{ item.link }}
                  {% else %}
                    {% set l = item.link|trim %}
                    {% set l_lower = l|lower %}
                    {% if '<a' in l_lower or '&lt;a' in l_lower %}
                      {{ l|raw }}
                    {% else %}
                      <a href="{{ l|escape('html_attr') }}" class="sidebar-title fw-semibold text-decoration-none">{{ (item.title is iterable ? item.title|join(' ') : item.title)|striptags }}</a>
                    {% endif %}
                  {% endif %}
                {% else %}
                  <span class="sidebar-title fw-semibold">{{ (item.title is iterable ? item.title|join(' ') : item.title)|striptags }}</span>
                {% endif %}
                <span class="small text-muted">{{ sstatus|capitalize }}</span>
              </div>
              {% if item.summary is defined and item.summary %}
                <div class="small text-muted mt-1">{{ (item.summary is iterable ? item.summary|join(' ') : item.summary)|striptags }}</div>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ul>
    </div>
  </div>

  <div class="mt-3 text-center">
    <a href="#" class="btn btn-outline-secondary btn-sm">Application Help</a>
  </div>
</nav>