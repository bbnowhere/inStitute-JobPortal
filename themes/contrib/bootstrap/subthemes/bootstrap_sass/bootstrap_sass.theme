<?php

/**
 * @file
 * Functions to support theming in the SASS Starterkit subtheme.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Session\AccountInterface;

/**
 * Implements hook_form_system_theme_settings_alter() for settings form.
 *
 * Replace Bootstrap setting options with subtheme ones.
 */
function bootstrap_sass_form_system_theme_settings_alter(&$form, FormStateInterface $form_state) {
  $form['components']['navbar']['bootstrap_navbar_top_background']['#options'] = array(
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  );
  $form['components']['navbar']['bootstrap_navbar_background']['#options'] = array(
    'bg-primary' => t('Primary'),
    'bg-secondary' => t('Secondary'),
    'bg-light' => t('Light'),
    'bg-dark' => t('Dark'),
    'bg-white' => t('White'),
    'bg-transparent' => t('Transparent'),
  );
}

function bootstrap_sass_preprocess_menu_local_tasks(&$variables) {
  // Only run on node pages.
  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');
  if ($node && is_object($node) && method_exists($node, 'bundle')) {
    $hide_bundles = [
      'personal_information',
      'education',
      'employment_details',
      'referee',
      'additional_information',
      'file_upload',
    ];
    if (in_array($node->bundle(), $hide_bundles, TRUE)) {
      // Remove all tabs (primary tasks).
      $variables['primary'] = [];
      // Optionally, also remove secondary tabs:
      $variables['secondary'] = [];
    }
  }
}

/**
 * Implements hook_preprocess_views_view_fields().
 */
function bootstrap_sass_preprocess_views_view_fields(&$variables) {
  $view = $variables['view'];
  if ($view->id() == 'open_positions' && $view->current_display == 'page_1') {
    $account = \Drupal::currentUser();
    $is_authenticated = $account->isAuthenticated();
    $uid = $account->id();

    $fields = $variables['fields'];
    $app_type = trim(strip_tags($fields['field_application_type']->content));
    $nid = trim(strip_tags($fields['nid']->content));
    $external_link = isset($fields['field_external_link']) ? trim(strip_tags($fields['field_external_link']->content)) : '';

    // Load the job node.
    $job_node = \Drupal\node\Entity\Node::load($nid);

    // Get the field_applicants values (multiple).
    $applicants = $job_node->get('field_applicants')->getValue();
    $user_application = NULL;

    // Check if any applicant was authored by current user.
    foreach ($applicants as $applicant_ref) {
      $applicant_nid = $applicant_ref['target_id'];
      $applicant_node = \Drupal\node\Entity\Node::load($applicant_nid);
      if ($applicant_node && $applicant_node->getOwnerId() == $uid) {
        $user_application = $applicant_node;
        break;
      }
    }

    $apply_markup = '';

    if ($app_type == 'Online') {
      if ($is_authenticated) {
        if ($user_application) {
          $job_status = $user_application->get('field_job_status')->value ?? '';

          if ($job_status == 'In Process') {
            $apply_markup = '<a href="/jobportal/apply/' . $nid . '" class="btn btn-success mt-2">Continue</a>';
          }
          elseif ($job_status == 'Completed') {
            $apply_markup = '<span class="badge bg-secondary mt-2">Already Applied</span>';
          }
          else {
            $apply_markup = '<a href="/jobportal/apply/' . $nid . '" class="btn btn-success mt-2">Apply</a>';
          }
        }
        else {
          // No application by this user.
          $apply_markup = '<a href="/jobportal/apply/' . $nid . '" class="btn btn-success mt-2">Apply</a>';
        }
      }
      else {
        $apply_markup = '<a href="/jobportal/user/login" class="btn btn-success mt-2"> Apply</a>';
      }
    }
    elseif ($app_type == 'External' && !empty($external_link)) {
      $apply_markup = '<a href="' . $external_link . '" target="_blank" class="btn btn-info mt-2">Apply </a>';
    }

    // Provide the HTML as a renderable '#markup' and attach cacheability
    // metadata so Drupal's render cache can vary and invalidate correctly.
    $cache = [
      'contexts' => ['user', 'route', 'url.query_args:job'],
      'tags' => [],
    ];
    // If we have a job nid and an authenticated user, add the job/user cache
    // tag so changes to a user's application invalidate the listing.
    if (!empty($nid) && $is_authenticated) {
      $cache['tags'][] = 'instemjobportal_app:job:' . $nid . ':user:' . $uid;
    }

    $variables['apply_markup'] = [
      '#markup' => $apply_markup,
      // Restrict allowed tags when rendering the raw HTML snippet.
      '#allowed_tags' => ['a', 'span', 'strong', 'em', 'p', 'br'],
      '#cache' => $cache,
    ];
  }
}

